generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  name             String
  slug             String            @unique
  twoFactorSecret  String?
  twoFactorEnabled Boolean           @default(false)
  isFirstLogin     Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  products         Product[]
  categories       Category[]
  orders           Order[]
  customers        Customer[]
  settings         Setting?
  marketingAssets  MarketingAsset[]

  @@map("user")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  order     Int       @default(0)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("category")
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  categoryName String   // Nome da categoria (para compatibilidade legada)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("product")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  address   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer")
}

model Order {
  id              String   @id @default(uuid())
  items           Json
  total           Float
  status          String   @default("pending")
  paymentMethod   String
  customerName    String
  customerPhone   String
  customerAddress String?
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("order")
}

model Setting {
  id                   String  @id @default("global")
  userId               String  @unique
  user                 User    @relation(fields: [userId], references: [id])
  openaiKey            String? @db.Text
  claudeKey            String? @db.Text
  mercadopagoToken     String? @db.Text
  mercadopagoPublicKey String? @db.Text
  activeModel          String  @default("openai")
  gcalEnabled          Boolean @default(false)
  gcalClientId         String?
  gcalClientSecret     String?
  gcalAccessToken      String? @db.Text
  gcalRefreshToken     String? @db.Text
  gcalTokenExpiry      String? @db.Text
  gcalCalendarId       String?
  gcalSyncHour         Int     @default(6)
  businessName         String?
  businessAddress      String?
  businessLocation     String?
  googleApiKey         String? @default("")
  deliveryRules        String? @db.Text
  managerJid           String?
  deliveryJid          String?
  dailyMaxOrders       Int     @default(10)
  maxDeliveryKm        Float   @default(15.0)
  dailyDeliveryItems   String? @db.Text
  reportEnabled        Boolean @default(false)
  reportHour           Int     @default(7)
  reminderHours        Int     @default(2)
  pixReceiverName      String? @db.Text
  pixReceiverKey       String? @db.Text
  smtpHost             String?
  smtpPort             Int?    @default(587)
  smtpUser             String?
  smtpPass             String? @db.Text
  smtpFrom             String?
  logoUrl              String?
  faviconUrl           String?
  accentColor          String? @default("#ff4d6d")
  buttonColor          String? @default("#ff4d6d")
  accentColorOrders    String? @default("#4a2c2a")
  buttonColorOrders    String? @default("#4a2c2a")
  buttonTextColor      String? @default("#ffffff")
  backgroundColor      String? @default("#ffffff")
  textColor            String? @default("#333333")

  @@map("setting")
}

model MarketingAsset {
  id        String   @id @default(uuid())
  name      String
  url       String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("marketing_asset")
}
