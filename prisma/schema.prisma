generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  name             String
  slug             String            @unique
  twoFactorSecret  String?
  twoFactorEnabled Boolean           @default(false)
  isFirstLogin     Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  products         Product[]
  categories       Category[]
  orders           Order[]
  customers        Customer[]
  settings         Setting?
  marketingAssets  MarketingAsset[]
  instances        Instance[]
  stockItems       StockItem[]
  calendarEvents   CalendarEvent[]
  seasonalCatalogs SeasonalCatalog[]

  @@map("user")
}

model Instance {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("disconnected")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("instance")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  order     Int       @default(0)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@map("category")
}

model Product {
  id              String    @id @default(uuid())
  name            String
  description     String?   @db.Text
  price           Float     @default(0)
  imageUrl        String?   @db.Text
  image           String?   @db.Text // Algumas partes usam 'image' em vez de 'imageUrl'
  categoryName    String?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  type            String    @default("delivery") // delivery, encomenda, addon
  variations      String?   @db.Text // JSON
  comboItems      String?   @db.Text // JSON
  trackStock      Boolean   @default(false)
  stock           Int       @default(0)
  capacityCost    Int       @default(1)
  featured        Boolean   @default(false)
  displayOrder    Int       @default(0)
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@map("product")
}

model Customer {
  id              String   @id @default(uuid())
  jid             String
  name            String?
  phone           String?
  address         String?  @db.Text
  lastOrderDate   DateTime?
  lastDeliveryFee Float?    @default(0)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([jid, userId], name: "jid_userId")
  @@map("customer")
}

model Order {
  id              String   @id @default(uuid())
  productId       String?
  product         String?
  variation       String?
  quantity        String?
  notes           String?  @db.Text
  scheduledDate   String?
  scheduledTime   String?
  clientName      String?
  clientJid       String?
  clientPhone     String?
  type            String   @default("order")
  deliveryAddress String?  @db.Text
  paymentMethod   String?
  paymentStatus   String   @default("pending")
  deliveryFee     Float    @default(0)
  totalValue      Float    @default(0)
  status          String   @default("pending")
  massa           String?
  recheio         String?
  topo            String?
  addons          String?  @db.Text // JSON
  calendarEventId String?
  instanceId      String?  @default("global")
  reminderSent    Boolean  @default(false)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@map("order")
}

model Setting {
  id                   String  @id @default("global")
  userId               String  @unique
  user                 User    @relation(fields: [userId], references: [id])
  openaiKey            String? @db.Text
  claudeKey            String? @db.Text
  mercadopagoToken     String? @db.Text
  mercadopagoPublicKey String? @db.Text
  activeModel          String  @default("openai")
  gcalEnabled          Boolean @default(false)
  gcalClientId         String?
  gcalClientSecret     String?
  gcalAccessToken      String? @db.Text
  gcalRefreshToken     String? @db.Text
  gcalTokenExpiry      String? @db.Text
  gcalCalendarId       String?
  gcalSyncHour         Int     @default(6)
  businessName         String?
  businessAddress      String?
  businessLocation     String?
  googleApiKey         String? @default("")
  deliveryRules        String? @db.Text
  managerJid           String?
  deliveryJid          String?
  dailyMaxOrders       Int     @default(10)
  maxDeliveryKm        Float   @default(15.0)
  dailyDeliveryItems   String? @db.Text
  reportEnabled        Boolean @default(false)
  reportHour           Int     @default(7)
  reminderHours        Int     @default(2)
  pixReceiverName      String? @db.Text
  pixReceiverKey       String? @db.Text
  smtpHost             String?
  smtpPort             Int?    @default(587)
  smtpUser             String?
  smtpPass             String? @db.Text
  smtpFrom             String?
  logoUrl              String? @db.Text
  faviconUrl           String? @db.Text
  accentColor          String? @default("#ff4d6d")
  buttonColor          String? @default("#ff4d6d")
  accentColorOrders    String? @default("#4a2c2a")
  buttonColorOrders    String? @default("#4a2c2a")
  buttonTextColor      String? @default("#ffffff")
  backgroundColor      String? @default("#ffffff")
  textColor            String? @default("#333333")

  @@map("setting")
}

model StockItem {
  id          String   @id @default(uuid())
  name        String
  quantity    Float    @default(0)
  unit        String   @default("un")
  minQuantity Float    @default(0)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("stock_item")
}

model CalendarEvent {
  id          String   @id
  title       String
  description String?  @db.Text
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  syncedAt    DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@map("calendar_event")
}

model SeasonalCatalog {
  id                      String   @id @default(uuid())
  name                    String
  eventDate               String
  preStartDays            Int      @default(15)
  postEndDays             Int      @default(2)
  description             String?  @db.Text
  items                   String?  @db.Text // JSON
  maxOrders               Int      @default(0)
  onlySeasonalOnEventDay  Boolean  @default(false)
  active                  Boolean  @default(true)
  userId                  String
  user                    User     @relation(fields: [userId], references: [id])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt

  @@map("seasonal_catalog")
}

model MarketingAsset {
  id        String   @id @default(uuid())
  name      String
  url       String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("marketing_asset")
}
